    "content_name": "SME Interview Question Bank",
    "content_description": "Generate structured, role-specific interview questions with what good answers look like, scoring anchors, and legally sensitive topics to avoid.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME Interview Question Bank starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Interview Question Bank.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_interview_question_bank\",\"focus\":\"competency-based questions, answer quality anchors, scoring, and legally sensitive topics\",\"intake\":\"Business context: Hiring an office manager for a 25-person architecture firm. Key competencies: organisation, vendor handling, discretion, basic bookkeeping. Two partners interview separately and currently ask different questions.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
  "columns": [

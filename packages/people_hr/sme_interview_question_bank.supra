{
  "key": "sme_interview_question_bank",
  "title": "SME Interview Question Bank",
  "description": "Generate structured, role-specific interview questions with what good answers look like, scoring anchors, and legally sensitive topics to avoid.",
  "workbench_title": "SME Interview Question Bank Desk",
  "schemaVersion": 1,
  "metadata": {
    "module_name": "sme_interview_question_bank",
    "vendor": "SupraTix",

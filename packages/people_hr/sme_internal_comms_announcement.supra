{
  "key": "sme_internal_comms_announcement",
  "title": "SME Internal Announcement Writer",
  "description": "Draft an internal announcement for a change such as a new policy, reorganisation, or system rollout, with clear reasons, what changes for whom, timeline, and Q&A.",
  "workbench_title": "SME Internal Announcement Writer Desk",
  "schemaVersion": 1,
  "metadata": {
    "module_name": "sme_internal_comms_announcement",
    "vendor": "SupraTix",
    "global_product_pk": "",
    "content_name": "SME Internal Announcement Writer",
    "content_description": "Draft an internal announcement for a change such as a new policy, reorganisation, or system rollout, with clear reasons, what changes for whom, timeline, and Q&A.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME Internal Announcement Writer starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Internal Announcement Writer.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_internal_comms_announcement\",\"focus\":\"change rationale, impact per group, timeline, tone, and anticipated questions\",\"intake\":\"Business context: Logistics company introduces a new time-tracking app for 90 drivers and 20 office staff from 1 November. Works council agreed. Drivers fear surveillance; office staff worry about a second login.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
  "columns": [
    {
      "key": "business_context",
      "title": "Business context",
      "column_kind": "step",
      "type": "fa-solid fa-file",
      "type_tool_input_dropdown": "fa-solid fa-file",
      "tool_category": "manual",

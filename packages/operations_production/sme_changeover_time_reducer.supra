{
  "key": "sme_changeover_time_reducer",
  "title": "SME Changeover Time Reducer",
  "description": "Analyse a changeover or setup process, separate internal from external steps, and propose a SMED-style plan with expected time savings, tooling needs, and verification runs.",
  "workbench_title": "SME Changeover Time Reducer Desk",
  "schemaVersion": 1,
  "metadata": {
    "module_name": "sme_changeover_time_reducer",
    "vendor": "SupraTix",
    "global_product_pk": "",
    "content_name": "SME Changeover Time Reducer",
    "content_description": "Analyse a changeover or setup process, separate internal from external steps, and propose a SMED-style plan with expected time savings, tooling needs, and verification runs.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME Changeover Time Reducer starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Changeover Time Reducer.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_changeover_time_reducer\",\"focus\":\"internal versus external steps, setup waste, standardization, expected savings, and verification\",\"intake\":\"Business context: Food packaging line changeover takes 95 minutes, 22 times per week. Steps include fetching tools from the storeroom, waiting for QA approval, and manual guide-rail adjustment without markings.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
  "columns": [

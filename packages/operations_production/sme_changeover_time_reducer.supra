      "tool_category": "ai_tool",
      "tool": "sme_changeover_time_reducer_signals",
      "prompt": "Analyze the SME context for internal versus external steps, setup waste, standardization, expected savings, and verification. Extract the most important facts, weak signals, constraints, assumptions, risks, and evidence gaps. Estimate likely impact qualitatively when numbers are missing. Do not invent facts. Return JSON only.",
      "tooling": {
        "prompt_execution": {
          "execute_prompt": true,
          "selected": true,
          "mode": "manual_review",

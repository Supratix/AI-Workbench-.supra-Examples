{
  "key": "sme_incident_to_cap_action_tracker",
  "title": "SME Corrective Action Tracker",
  "description": "Turn audit findings, incidents, and customer claims into a corrective and preventive action list with priority, owner, due date, evidence of closure, and effectiveness check.",
  "workbench_title": "SME Corrective Action Tracker Desk",
  "schemaVersion": 1,
  "metadata": {
    "module_name": "sme_incident_to_cap_action_tracker",
    "vendor": "SupraTix",
    "global_product_pk": "",
    "content_name": "SME Corrective Action Tracker",
    "content_description": "Turn audit findings, incidents, and customer claims into a corrective and preventive action list with priority, owner, due date, evidence of closure, and effectiveness check.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME Corrective Action Tracker starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Corrective Action Tracker.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_incident_to_cap_action_tracker\",\"focus\":\"finding classification, corrective actions, owners and due dates, closure evidence, and effectiveness\",\"intake\":\"Business context: ISO 9001 surveillance audit produced 2 minor nonconformities and 6 observations. Additionally two customer claims about labelling. Next audit in 11 months; the quality manager works part-time.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
  "columns": [
    {
      "key": "business_context",
      "title": "Business context",
      "column_kind": "step",
      "type": "fa-solid fa-file",
      "type_tool_input_dropdown": "fa-solid fa-file",

  "key": "sme_subcontractor_bid_consolidator",
  "title": "SME Subcontractor Bid Consolidator",
  "description": "Consolidate subcontractor quotes into a bid calculation with scope coverage checks, price normalisation, risk allowances, and open clarifications before submission.",

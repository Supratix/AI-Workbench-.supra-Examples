    "starter_rows": [
      {
        "title": "SME Subcontractor Bid Consolidator starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Subcontractor Bid Consolidator.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_subcontractor_bid_consolidator\",\"focus\":\"scope coverage, price normalisation, risk allowances, open clarifications, and bid summary\",\"intake\":\"Business context: General contractor prepares a 1.4M EUR school renovation bid with quotes from five trades. The electrical quote excludes fire alarm wiring, two quotes have different validity dates, and the roofing quote is per square metre without quantities.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },

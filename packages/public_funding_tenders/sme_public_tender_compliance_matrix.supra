{
  "key": "sme_public_tender_compliance_matrix",
  "title": "SME Public Tender Compliance Matrix",
  "description": "Extract every mandatory requirement from tender documents into a compliance matrix with status, responsible person, evidence, and deadline, and flag exclusion risks.",
  "workbench_title": "SME Public Tender Compliance Matrix Desk",
  "schemaVersion": 1,
  "metadata": {
    "module_name": "sme_public_tender_compliance_matrix",
    "vendor": "SupraTix",
    "global_product_pk": "",
    "content_name": "SME Public Tender Compliance Matrix",
    "content_description": "Extract every mandatory requirement from tender documents into a compliance matrix with status, responsible person, evidence, and deadline, and flag exclusion risks.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME Public Tender Compliance Matrix starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Public Tender Compliance Matrix.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_public_tender_compliance_matrix\",\"focus\":\"mandatory requirements, evidence status, responsible persons, deadlines, and exclusion risks\",\"intake\":\"Business context: Municipal tender for facility cleaning of six schools. Requirements include minimum wage declaration, three references over 200k EUR, ISO 14001 or equivalent, and a bid bond. Submission in 12 days.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
  "columns": [
    {
      "key": "business_context",
      "title": "Business context",
      "column_kind": "step",
      "type": "fa-solid fa-file",
      "type_tool_input_dropdown": "fa-solid fa-file",
      "tool_category": "manual",
      "tool": "user_input",
      "tooling": {
        "prompt_execution": {
          "execute_prompt": false,

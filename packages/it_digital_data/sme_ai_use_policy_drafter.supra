    "content_name": "SME AI Use Policy Drafter",
    "content_description": "Draft a practical internal AI usage policy with allowed and prohibited uses, data handling rules, review duties, tool approval, and training needs, marking points for legal review.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME AI Use Policy Drafter starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME AI Use Policy Drafter.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_ai_use_policy_drafter\",\"focus\":\"allowed and prohibited uses, data handling, human review duties, tool approval, and training\",\"intake\":\"Business context: Consulting boutique with 22 staff. Several consultants already paste client documents into public chat tools. Clients include two banks with strict confidentiality clauses. No policy exists.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
  "columns": [
    {

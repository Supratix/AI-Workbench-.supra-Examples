{
  "key": "sme_ai_use_policy_drafter",
  "title": "SME AI Use Policy Drafter",
  "description": "Draft a practical internal AI usage policy with allowed and prohibited uses, data handling rules, review duties, tool approval, and training needs, marking points for legal review.",
  "workbench_title": "SME AI Use Policy Drafter Desk",
  "schemaVersion": 1,

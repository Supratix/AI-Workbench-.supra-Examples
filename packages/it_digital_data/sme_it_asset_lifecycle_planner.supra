      ],
      "tool_category": "ai_tool",
      "tool": "sme_it_asset_lifecycle_planner_signals",
      "prompt": "Analyze the SME context for asset age and support status, replacement priority, budget schedule, and unsupported system risk. Extract the most important facts, weak signals, constraints, assumptions, risks, and evidence gaps. Estimate likely impact qualitatively when numbers are missing. Do not invent facts. Return JSON only.",
      "tooling": {
        "prompt_execution": {
          "execute_prompt": true,
          "selected": true,
          "mode": "manual_review",
          "requires_review": true,
          "label": "Map signals",
          "reason": "sme_example_package"
        },
        "output_contract": {

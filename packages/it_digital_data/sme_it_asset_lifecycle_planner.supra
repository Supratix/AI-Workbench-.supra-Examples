{
  "key": "sme_it_asset_lifecycle_planner",
  "title": "SME IT Asset Lifecycle Planner",
  "description": "Plan hardware and licence replacements from an asset inventory with age, support status, and cost, producing a budgeted refresh schedule and risk flags for unsupported systems.",
  "workbench_title": "SME IT Asset Lifecycle Planner Desk",
  "schemaVersion": 1,
  "metadata": {
    "module_name": "sme_it_asset_lifecycle_planner",
    "vendor": "SupraTix",
    "global_product_pk": "",
    "content_name": "SME IT Asset Lifecycle Planner",
    "content_description": "Plan hardware and licence replacements from an asset inventory with age, support status, and cost, producing a budgeted refresh schedule and risk flags for unsupported systems.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME IT Asset Lifecycle Planner starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME IT Asset Lifecycle Planner.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_it_asset_lifecycle_planner\",\"focus\":\"asset age and support status, replacement priority, budget schedule, and unsupported system risk\",\"intake\":\"Business context: Tax advisory firm has 34 laptops (11 older than five years), one file server out of vendor support, and 40 office licences on a plan ending next year. Annual IT budget 45k EUR.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
  "columns": [

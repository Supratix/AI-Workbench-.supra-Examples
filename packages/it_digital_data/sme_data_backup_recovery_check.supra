      "tool": "sme_data_backup_recovery_check_signals",
      "prompt": "Analyze the SME context for backup coverage, recovery objectives, offsite copies, restore testing, and prioritized fixes. Extract the most important facts, weak signals, constraints, assumptions, risks, and evidence gaps. Estimate likely impact qualitatively when numbers are missing. Do not invent facts. Return JSON only.",
      "tooling": {
        "prompt_execution": {
          "execute_prompt": true,
          "selected": true,

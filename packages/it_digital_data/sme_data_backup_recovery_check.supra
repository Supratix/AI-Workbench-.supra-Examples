{
  "key": "sme_data_backup_recovery_check",
  "title": "SME Backup And Recovery Check",
  "description": "Assess backup coverage, frequency, retention, offsite copies, and restore testing against the company's tolerance for data loss and downtime, and propose a prioritized fix list.",
  "workbench_title": "SME Backup And Recovery Check Desk",
  "schemaVersion": 1,
  "metadata": {
    "module_name": "sme_data_backup_recovery_check",
    "vendor": "SupraTix",
    "global_product_pk": "",
    "content_name": "SME Backup And Recovery Check",
    "content_description": "Assess backup coverage, frequency, retention, offsite copies, and restore testing against the company's tolerance for data loss and downtime, and propose a prioritized fix list.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME Backup And Recovery Check starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Backup And Recovery Check.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_data_backup_recovery_check\",\"focus\":\"backup coverage, recovery objectives, offsite copies, restore testing, and prioritized fixes\",\"intake\":\"Business context: Architecture office stores project files on a NAS with nightly backup to a USB drive kept in the same room. Cloud email is not backed up. Last restore test: never. Acceptable data loss per owner: one day.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },

{
  "key": "sme_digital_maturity_assessment",
  "title": "SME Digital Maturity Assessment",
  "description": "Assess digital maturity across processes, data, tools, skills, and security from a self-description, and produce a realistic 12-month roadmap with quick wins and prerequisites.",
  "workbench_title": "SME Digital Maturity Assessment Desk",
  "schemaVersion": 1,
  "metadata": {
    "module_name": "sme_digital_maturity_assessment",
    "vendor": "SupraTix",
    "global_product_pk": "",
    "content_name": "SME Digital Maturity Assessment",
    "content_description": "Assess digital maturity across processes, data, tools, skills, and security from a self-description, and produce a realistic 12-month roadmap with quick wins and prerequisites.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME Digital Maturity Assessment starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Digital Maturity Assessment.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_digital_maturity_assessment\",\"focus\":\"maturity per dimension, quick wins, prerequisites, 12-month roadmap, and capacity constraints\",\"intake\":\"Business context: Regional bakery with 9 shops runs orders by phone and paper, uses a cash register system without reporting, has no shared calendar, and wants online pre-ordering. The owner's son handles IT part-time.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
  "columns": [
    {
      "key": "business_context",
      "title": "Business context",
      "column_kind": "step",
      "type": "fa-solid fa-file",
      "type_tool_input_dropdown": "fa-solid fa-file",
      "tool_category": "manual",
      "tool": "user_input",
      "tooling": {

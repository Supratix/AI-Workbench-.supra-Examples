      "tool": "sme_kpi_dashboard_spec_signals",
      "prompt": "Analyze the SME context for KPI selection, definitions, data sources, update cadence, and alert thresholds. Extract the most important facts, weak signals, constraints, assumptions, risks, and evidence gaps. Estimate likely impact qualitatively when numbers are missing. Do not invent facts. Return JSON only.",
      "tooling": {
        "prompt_execution": {
          "execute_prompt": true,
          "selected": true,

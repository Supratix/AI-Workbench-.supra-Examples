{
  "key": "sme_kpi_dashboard_spec",
  "title": "SME KPI Dashboard Specifier",
  "description": "Specify a management dashboard with the few KPIs that matter, definitions, data sources, update frequency, owners, and alert thresholds, avoiding vanity metrics.",
  "workbench_title": "SME KPI Dashboard Specifier Desk",

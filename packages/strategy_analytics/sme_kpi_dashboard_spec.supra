    "content_description": "Specify a management dashboard with the few KPIs that matter, definitions, data sources, update frequency, owners, and alert thresholds, avoiding vanity metrics.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME KPI Dashboard Specifier starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME KPI Dashboard Specifier.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_kpi_dashboard_spec\",\"focus\":\"KPI selection, definitions, data sources, update cadence, and alert thresholds\",\"intake\":\"Business context: Cleaning services company wants one weekly dashboard for the owner. Data: scheduling tool, invoicing software, timesheets, customer complaints log. Currently 40 metrics are reported monthly and nobody reads them.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },

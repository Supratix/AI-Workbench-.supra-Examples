    "content_description": "Turn account history, stakeholder notes, and open needs into a 90-day key account plan with expansion hypotheses, relationship actions, risks, and review metrics.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME Key Account Growth Plan starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Key Account Growth Plan.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_key_account_growth_plan\",\"focus\":\"account health, stakeholder map, expansion hypotheses, relationship risks, and 90-day actions\",\"intake\":\"Business context: Packaging supplier's largest customer (18 percent of revenue) just changed purchasing lead. Volume is flat, two quality complaints last quarter, and the customer is opening a second plant in Poland next spring.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
  "columns": [

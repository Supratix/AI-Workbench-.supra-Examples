      "tool": "sme_key_account_growth_plan_signals",
      "prompt": "Analyze the SME context for account health, stakeholder map, expansion hypotheses, relationship risks, and 90-day actions. Extract the most important facts, weak signals, constraints, assumptions, risks, and evidence gaps. Estimate likely impact qualitatively when numbers are missing. Do not invent facts. Return JSON only.",
      "tooling": {
        "prompt_execution": {
          "execute_prompt": true,
          "selected": true,
          "mode": "manual_review",
          "requires_review": true,
          "label": "Map signals",

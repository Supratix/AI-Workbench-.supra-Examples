{
  "key": "sme_key_account_growth_plan",
  "title": "SME Key Account Growth Plan",
  "description": "Turn account history, stakeholder notes, and open needs into a 90-day key account plan with expansion hypotheses, relationship actions, risks, and review metrics.",
  "workbench_title": "SME Key Account Growth Plan Desk",

    "starter_rows": [
      {
        "title": "SME Trade Show ROI Planner starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Trade Show ROI Planner.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_trade_show_roi_planner\",\"focus\":\"show goals, lead targets, budget and staffing, follow-up plan, and break-even assumptions\",\"intake\":\"Business context: Sensor manufacturer considers a 36 square metre stand at an industrial fair. Cost estimate 48k EUR including travel. Average deal 22k EUR at 40 percent margin, typical lead-to-deal rate 6 percent, sales cycle five months.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",

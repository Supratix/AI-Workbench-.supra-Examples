      "tool_category": "ai_tool",
      "tool": "sme_thirteen_week_cash_forecast_signals",
      "prompt": "Analyze the SME context for weekly cash inflows and outflows, liquidity gaps, timing assumptions, and owner decisions. Extract the most important facts, weak signals, constraints, assumptions, risks, and evidence gaps. Estimate likely impact qualitatively when numbers are missing. Do not invent facts. Return JSON only.",
      "tooling": {
        "prompt_execution": {
          "execute_prompt": true,
          "selected": true,

{
  "key": "sme_thirteen_week_cash_forecast",
  "title": "SME 13-Week Cash Forecast Builder",
  "description": "Turn bank balances, open invoices, payables, payroll dates, and known commitments into a reviewable 13-week cash forecast with weekly gaps, assumptions, and owner actions.",
  "workbench_title": "SME 13-Week Cash Forecast Builder Desk",
  "schemaVersion": 1,
  "metadata": {
    "module_name": "sme_thirteen_week_cash_forecast",
    "vendor": "SupraTix",
    "global_product_pk": "",
    "content_name": "SME 13-Week Cash Forecast Builder",
    "content_description": "Turn bank balances, open invoices, payables, payroll dates, and known commitments into a reviewable 13-week cash forecast with weekly gaps, assumptions, and owner actions.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME 13-Week Cash Forecast Builder starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME 13-Week Cash Forecast Builder.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_thirteen_week_cash_forecast\",\"focus\":\"weekly cash inflows and outflows, liquidity gaps, timing assumptions, and owner decisions\",\"intake\":\"Business context: Metal fabrication shop with 22 staff. Bank balance 84k EUR, open customer invoices 210k EUR (three overdue), supplier payables 120k EUR due within four weeks, payroll 58k EUR on the 28th, VAT payment 31k EUR due in week 3. A 40k EUR machine deposit is planned for week 6.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
  "columns": [

{
  "key": "sme_credit_risk_screener",
  "title": "SME Customer Credit Risk Screener",
  "description": "Screen a new or existing customer for credit risk using payment history, order size, public signals, and contract terms, and recommend limits, prepayment, or escalation.",
  "workbench_title": "SME Customer Credit Risk Screener Desk",
  "schemaVersion": 1,
  "metadata": {
    "module_name": "sme_credit_risk_screener",
    "vendor": "SupraTix",
    "global_product_pk": "",
    "content_name": "SME Customer Credit Risk Screener",
    "content_description": "Screen a new or existing customer for credit risk using payment history, order size, public signals, and contract terms, and recommend limits, prepayment, or escalation.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME Customer Credit Risk Screener starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Customer Credit Risk Screener.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_credit_risk_screener\",\"focus\":\"payment behaviour, exposure size, warning signals, credit limits, and prepayment or escalation rules\",\"intake\":\"Business context: Wholesale customer places a 68k EUR order, three times its usual size. Two of the last six invoices were paid 20 days late. Their website announced a new CFO last month. Payment terms are 30 days net.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
  "columns": [
    {
      "key": "business_context",
      "title": "Business context",
      "column_kind": "step",
      "type": "fa-solid fa-file",
      "type_tool_input_dropdown": "fa-solid fa-file",
      "tool_category": "manual",
      "tool": "user_input",
      "tooling": {

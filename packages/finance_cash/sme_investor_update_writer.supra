{
  "key": "sme_investor_update_writer",
  "title": "SME Investor And Stakeholder Update Writer",
  "description": "Draft a concise monthly investor or shareholder update from KPIs, wins, problems, cash runway, and asks, keeping facts separated from projections.",
  "workbench_title": "SME Investor And Stakeholder Update Writer Desk",
  "schemaVersion": 1,
  "metadata": {
    "module_name": "sme_investor_update_writer",
    "vendor": "SupraTix",
    "global_product_pk": "",
    "content_name": "SME Investor And Stakeholder Update Writer",
    "content_description": "Draft a concise monthly investor or shareholder update from KPIs, wins, problems, cash runway, and asks, keeping facts separated from projections.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME Investor And Stakeholder Update Writer starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Investor And Stakeholder Update Writer.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_investor_update_writer\",\"focus\":\"KPI narrative, wins and problems, cash runway, specific asks, and fact-versus-projection separation\",\"intake\":\"Business context: Seed-funded hardware startup, 9 people. MRR 41k EUR (up 8 percent), runway 11 months, first pilot with a logistics company signed, firmware delay of six weeks, hiring a firmware engineer. Ask: intro to two distributors.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
  "columns": [

      ],
      "tool_category": "ai_tool",
      "tool": "sme_investor_update_writer_signals",
      "prompt": "Analyze the SME context for KPI narrative, wins and problems, cash runway, specific asks, and fact-versus-projection separation. Extract the most important facts, weak signals, constraints, assumptions, risks, and evidence gaps. Estimate likely impact qualitatively when numbers are missing. Do not invent facts. Return JSON only.",
      "tooling": {
        "prompt_execution": {
          "execute_prompt": true,
          "selected": true,
          "mode": "manual_review",
          "requires_review": true,
          "label": "Map signals",
          "reason": "sme_example_package"
        },
        "output_contract": {

{
  "key": "sme_website_copy_refresher",
  "title": "SME Website Copy Refresher",
  "description": "Rewrite key website sections for clarity and conversion using company facts and customer language, keeping every claim traceable and marking claims that need proof.",
  "workbench_title": "SME Website Copy Refresher Desk",
  "schemaVersion": 1,
  "metadata": {
    "module_name": "sme_website_copy_refresher",
    "vendor": "SupraTix",
    "global_product_pk": "",
    "content_name": "SME Website Copy Refresher",
    "content_description": "Rewrite key website sections for clarity and conversion using company facts and customer language, keeping every claim traceable and marking claims that need proof.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME Website Copy Refresher starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Website Copy Refresher.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_website_copy_refresher\",\"focus\":\"headline clarity, benefit language, proof-backed claims, calls to action, and unverified claims\",\"intake\":\"Business context: Electrician company homepage says 'We are the best in the region' with no proof. Facts available: 1,200 jobs last year, 4.8 star rating from 310 reviews, emergency service within 2 hours in the city.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
  "columns": [
    {
      "key": "business_context",
      "title": "Business context",
      "column_kind": "step",
      "type": "fa-solid fa-file",
      "type_tool_input_dropdown": "fa-solid fa-file",

      "tool": "sme_ad_campaign_brief_builder_signals",
      "prompt": "Analyze the SME context for campaign objective, audience, offer, creative angles, budget allocation, tracking, and kill criteria. Extract the most important facts, weak signals, constraints, assumptions, risks, and evidence gaps. Estimate likely impact qualitatively when numbers are missing. Do not invent facts. Return JSON only.",
      "tooling": {
        "prompt_execution": {
          "execute_prompt": true,
          "selected": true,
          "mode": "manual_review",
          "requires_review": true,
          "label": "Map signals",
          "reason": "sme_example_package"

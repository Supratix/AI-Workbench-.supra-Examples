{
  "key": "sme_ad_campaign_brief_builder",
  "title": "SME Ad Campaign Brief Builder",
  "description": "Build a paid campaign brief with objective, audience, offer, creative angles, budget split, tracking plan, and kill criteria, with assumptions and evidence gaps made explicit.",
  "workbench_title": "SME Ad Campaign Brief Builder Desk",
  "schemaVersion": 1,
  "metadata": {
    "module_name": "sme_ad_campaign_brief_builder",
    "vendor": "SupraTix",
    "global_product_pk": "",
    "content_name": "SME Ad Campaign Brief Builder",
    "content_description": "Build a paid campaign brief with objective, audience, offer, creative angles, budget split, tracking plan, and kill criteria, with assumptions and evidence gaps made explicit.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME Ad Campaign Brief Builder starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Ad Campaign Brief Builder.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_ad_campaign_brief_builder\",\"focus\":\"campaign objective, audience, offer, creative angles, budget allocation, tracking, and kill criteria\",\"intake\":\"Business context: Driving school wants 60 new sign-ups in eight weeks for its summer intensive course at 1,890 EUR. Budget 4,500 EUR. Past Instagram ads got sign-ups at about 95 EUR each; Google Ads were never tried.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
  "columns": [
    {

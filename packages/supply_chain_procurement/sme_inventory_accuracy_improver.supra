{
  "key": "sme_inventory_accuracy_improver",
  "title": "SME Inventory Accuracy Improver",
  "description": "Diagnose causes of inventory record inaccuracy from count results and process observations, and propose cycle counting, process, and system fixes with measurable targets.",

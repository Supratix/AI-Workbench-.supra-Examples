    "starter_rows": [
      {
        "title": "SME Inventory Accuracy Improver starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Inventory Accuracy Improver.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_inventory_accuracy_improver\",\"focus\":\"count discrepancies, process causes, cycle counting design, system fixes, and accuracy targets\",\"intake\":\"Business context: Building materials dealer found 19 percent of locations with discrepancies at the annual count. Causes suspected: unbooked returns, split pallets, drivers picking without scanning. No cycle counts exist.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },

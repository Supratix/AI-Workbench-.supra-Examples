{
  "key": "sme_supplier_risk_scorecard",
  "title": "SME Supplier Risk Scorecard",
  "description": "Score suppliers on delivery performance, quality, financial signals, concentration, and geography, and propose mitigation such as dual sourcing, stock buffers, or contract changes.",
  "workbench_title": "SME Supplier Risk Scorecard Desk",
  "schemaVersion": 1,
  "metadata": {
    "module_name": "sme_supplier_risk_scorecard",
    "vendor": "SupraTix",

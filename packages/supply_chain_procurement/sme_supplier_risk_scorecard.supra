    "content_name": "SME Supplier Risk Scorecard",
    "content_description": "Score suppliers on delivery performance, quality, financial signals, concentration, and geography, and propose mitigation such as dual sourcing, stock buffers, or contract changes.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME Supplier Risk Scorecard starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Supplier Risk Scorecard.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_supplier_risk_scorecard\",\"focus\":\"delivery and quality performance, financial signals, concentration risk, and mitigation options\",\"intake\":\"Business context: Electronics assembler buys 60 percent of PCB volume from one supplier in Asia with 87 percent on-time delivery. Second supplier is 30 percent more expensive. One critical connector has a single source with 16-week lead time.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
  "columns": [

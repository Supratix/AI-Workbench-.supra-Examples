      "tool": "sme_supplier_risk_scorecard_signals",
      "prompt": "Analyze the SME context for delivery and quality performance, financial signals, concentration risk, and mitigation options. Extract the most important facts, weak signals, constraints, assumptions, risks, and evidence gaps. Estimate likely impact qualitatively when numbers are missing. Do not invent facts. Return JSON only.",
      "tooling": {
        "prompt_execution": {
          "execute_prompt": true,
          "selected": true,
          "mode": "manual_review",
          "requires_review": true,
          "label": "Map signals",

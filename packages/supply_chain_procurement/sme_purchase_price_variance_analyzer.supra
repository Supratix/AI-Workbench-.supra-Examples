{
  "key": "sme_purchase_price_variance_analyzer",
  "title": "SME Purchase Price Variance Analyzer",
  "description": "Analyse purchase price changes across suppliers and materials, separate market effects from negotiation and volume effects, and propose renegotiation or substitution actions.",
  "workbench_title": "SME Purchase Price Variance Analyzer Desk",

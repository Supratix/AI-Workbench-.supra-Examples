      "tool": "sme_purchase_price_variance_analyzer_signals",
      "prompt": "Analyze the SME context for price variance drivers, market versus negotiation effects, volume impact, and renegotiation targets. Extract the most important facts, weak signals, constraints, assumptions, risks, and evidence gaps. Estimate likely impact qualitatively when numbers are missing. Do not invent facts. Return JSON only.",
      "tooling": {
        "prompt_execution": {
          "execute_prompt": true,
          "selected": true,

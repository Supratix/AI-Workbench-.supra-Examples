{
  "key": "sme_reorder_point_calculator",
  "title": "SME Reorder Point Calculator",
  "description": "Derive reorder points and order quantities from demand history, lead times, and service level targets, and flag items where data quality makes the result unreliable.",
  "workbench_title": "SME Reorder Point Calculator Desk",

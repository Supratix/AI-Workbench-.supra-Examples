    "starter_rows": [
      {
        "title": "SME Reorder Point Calculator starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Reorder Point Calculator.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_reorder_point_calculator\",\"focus\":\"demand variability, lead times, safety stock, order quantities, and data reliability\",\"intake\":\"Business context: Spare parts dealer with 2,400 SKUs. Top 50 items have 12 months of daily sales data; lead times range from 2 to 45 days. Target service level 97 percent for A items. Stockouts last month: 38.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },

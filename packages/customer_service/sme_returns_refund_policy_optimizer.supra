      "tool": "sme_returns_refund_policy_optimizer_signals",
      "prompt": "Analyze the SME context for return drivers, fraud patterns, cost per return, legal minimums, and policy wording. Extract the most important facts, weak signals, constraints, assumptions, risks, and evidence gaps. Estimate likely impact qualitatively when numbers are missing. Do not invent facts. Return JSON only.",
      "tooling": {
        "prompt_execution": {
          "execute_prompt": true,

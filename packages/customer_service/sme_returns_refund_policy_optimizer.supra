    "starter_rows": [
      {
        "title": "SME Returns And Refund Policy Optimizer starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Returns And Refund Policy Optimizer.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_returns_refund_policy_optimizer\",\"focus\":\"return drivers, fraud patterns, cost per return, legal minimums, and policy wording\",\"intake\":\"Business context: Fashion webshop: 31 percent return rate, 4 percent of customers cause 28 percent of returns, average return handling cost 6.40 EUR. Current policy: free returns within 60 days. EU 14-day withdrawal right applies.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",

{
  "key": "sme_returns_refund_policy_optimizer",
  "title": "SME Returns And Refund Policy Optimizer",
  "description": "Review return data and current policy to balance customer trust, fraud risk, cost, and legal minimums, and propose policy wording, process changes, and metrics.",
  "workbench_title": "SME Returns And Refund Policy Optimizer Desk",

{
  "key": "sme_insurance_coverage_checker",
  "title": "SME Insurance Coverage Checker",
  "description": "Compare business activities and assets with existing insurance policies to spot coverage gaps, overlaps, and outdated sums, and prepare questions for a broker.",
  "workbench_title": "SME Insurance Coverage Checker Desk",
  "schemaVersion": 1,

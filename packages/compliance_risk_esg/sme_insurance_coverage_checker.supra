    "content_description": "Compare business activities and assets with existing insurance policies to spot coverage gaps, overlaps, and outdated sums, and prepare questions for a broker.",
    "export_version": "1.0.0",
    "import_version": "1.0.0",
    "starter_rows": [
      {
        "title": "SME Insurance Coverage Checker starter",
        "source_type": "business_context",
        "external_urls": [],
        "request": "Paste the source context for SME Insurance Coverage Checker.",
        "text": "{\"schema\":\"DISRUPTIVE_SME_INTAKE_V1\",\"use_case\":\"sme_insurance_coverage_checker\",\"focus\":\"activity and asset inventory, coverage gaps, overlaps, outdated sums, and broker questions\",\"intake\":\"Business context: Carpentry business added a CNC machine worth 180k EUR and started selling online. Policies: liability from 2016, contents insured at 250k EUR, no cyber cover, no product liability for online sales.\\nCurrent situation: Inputs are incomplete, owners need an answer this week, and leadership wants visible assumptions.\\nKnown constraint: Do not invent facts; mark evidence gaps and human-review items.\",\"guardrails\":[\"Do not invent facts.\",\"Mark assumptions and evidence gaps.\",\"Prefer actions that can be started this week.\",\"Keep financial, legal, safety, and compliance advice reviewable by a responsible human.\"],\"target_outputs\":[\"signal_map\",\"decision_plan\",\"execution_brief\"]}"
      }
    ],
    "commerce": {
      "business_model": "free_of_use",
      "product_typ": "workflows",
      "usage_unit": "cloud_credits",
      "quota": {
        "unit": "cloud_credits"
      }
    },
    "source_attribution": {
      "text": "AI Workbench .supra examples repository",
      "url": "https://github.com/Supratix/AI-Workbench-.supra-Examples"
    }
  },
